---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rail from '../../components/Rail.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { allCategories, entriesIn, subcategoriesIn } from '../../lib/grimoire';
import { breadcrumbs, siteNodes } from '../../lib/schema';

const CATEGORIES_DESCRIPTION =
  'The seven shelves the grimoire is organised into, ordered roughly the way ' +
  'a forward pass is built and then taken apart again.';

const categories = await Promise.all(
  (await allCategories()).map(async (cat) => ({
    cat,
    entries: await entriesIn(cat.id),
    subs: await subcategoriesIn(cat.id),
  }))
);
const branches = categories.reduce((n, c) => n + c.subs.length, 0);
---

<BaseLayout
  title="Categories"
  tabTitle="Categories — AI Grimoire"
  description={CATEGORIES_DESCRIPTION}
  nav="categories"
  schema={[
    ...siteNodes(),
    breadcrumbs([{ name: 'AI Grimoire', path: '/' }, { name: 'Categories' }]),
  ]}
>
  <main class="mx-auto max-w-[1180px] animate-rise px-6 pb-20 sm:px-12">
    <Breadcrumb trail={[{ label: 'AI Grimoire', href: '/' }, { label: 'Categories' }]} />

    <Rail labelAs="h2" label="Shelves" class="pt-12 pb-9">
      <h1 class="mt-0 mb-4 text-[34px] font-normal tracking-[-0.022em] text-bone">
        Categories
      </h1>
      <p class="mt-0 mb-0 max-w-[62ch] text-[18px] text-lede text-pretty">
        Seven shelves, ordered roughly the way a forward pass is built and then taken
        apart again. Each divides into branches — {branches} of them in all — and an
        entry lives on exactly one branch. Cross-references do the rest.
      </p>
    </Rail>

    <Rail labelAs="h2" label="Contents" divider={false} class="pt-9">
      {
        categories.map(({ cat, entries, subs }) => {
          const stubs = entries.filter((e) => e.data.stub).length;
          return (
            <div class="grid grid-cols-[30px_minmax(0,1fr)] items-baseline gap-x-5 gap-y-1 border-b border-rule-faint py-5 sm:grid-cols-[30px_minmax(0,1fr)_110px]">
              <span class="font-mono text-[11px] text-dim-3">{cat.data.num}</span>
              <div>
                <a
                  href={`/categories/${cat.id}`}
                  class="text-[22px] leading-[1.3] tracking-[-0.014em] text-bone hover:text-accent"
                >
                  {cat.data.name}
                </a>
                <div class="mt-1 max-w-[64ch] text-[15px] text-mute-3 text-pretty">
                  {cat.data.blurb}
                </div>
                <div class="mt-2.5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px]">
                  {subs.map((sub) => {
                    const leaf = sub.id.split('/').pop()!;
                    const n = entries.filter((e) => e.data.path.id === sub.id).length;
                    return (
                      <a
                        href={`/categories/${cat.id}/${leaf}`}
                        class="text-dim-2 hover:text-chalk"
                      >
                        {leaf}/<span class="text-dim-3"> {n}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
              <span class="col-start-2 mt-2 font-mono text-[11px] text-dim-2 sm:col-start-3 sm:mt-0 sm:text-right">
                {entries.length} entries
                {stubs > 0 && <span class="text-accent"> · {stubs} stub{stubs > 1 ? 's' : ''}</span>}
              </span>
            </div>
          );
        })
      }
    </Rail>
  </main>
</BaseLayout>
